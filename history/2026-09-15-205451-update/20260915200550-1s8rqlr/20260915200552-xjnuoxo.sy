pe":"NodeText","Data":"广东"}]},{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeText","Data":"A"}]},{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeText","Data":"未上榜"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"mark","TextMarkTextContent":"中央民族大学"}]},{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeText","Data":"北京"}]},{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeText","Data":"A"}]},{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeText","Data":"未上榜"}]}]}]},{"ID":"20260915200940-mzw4cv7","Type":"NodeParagraph","Properties":{"id":"20260915200940-mzw4cv7","updated":"20260915204423"},"Children":[{"Type":"NodeText","Data":"A区（考研一区，共21个省/市）中，表中尚未出现的有4个："},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"河北、山西、江西、河南"},{"Type":"NodeText","Data":"。表中学校已覆盖北京、天津、辽宁、吉林、黑龙江、上海、江苏、浙江、安徽、福建、山东、湖北、湖南、广东、重庆、四川、陕西共17个省（市），另甘肃属B区。"}]},{"ID":"20260915205252-xez2zd2","Type":"NodeParagraph","Properties":{"id":"20260915205252-xez2zd2","updated":"20260915205252"},"Children":[{"Type":"NodeText","Data":"若再把表中已高亮的14所学校（华南理工大学、中山大学、东北大学、华东师范大学、湖南大学、国防科技大学、中国人民大学、中国农业大学、吉林大学、兰州大学、西北农林科技大学、北京师范大学、中国海洋大学、中央民族大学）也去掉，A区未出现的省份不减反增，新少了2个："},{"Type":"NodeTextMark","TextMarkType":"mark","TextMarkTextContent":"广东"},{"Type":"NodeText","Data":"（华南理工大学、中山大学同时被去掉）、"},{"Type":"NodeTextMark","TextMarkType":"mark","TextMarkTextContent":"吉林"},{"Type":"NodeText","Data":"（吉林大学被去掉）。此时A区未出现的省份共6个：河北、山西、江西、河南、广东、吉林。（甘肃也因兰州大学被去掉而没有学校代表，但属B区。）"}]}]}